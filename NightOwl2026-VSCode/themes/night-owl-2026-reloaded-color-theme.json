  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#CCE2EF",
        "background": "#011627"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#637777",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#ECC48D"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"],
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ADDB67",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string.other.attribute-value"],
      "settings": {
        "foreground": "#ECC48D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFCB8B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.section"],
      "settings": {
        "foreground": "#CE93D8"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#CCE2EF"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#CCE2EF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable.language", "variable.language.this"],
      "settings": {
        "foreground": "#FF5874"
      }
    },
    {
      "scope": ["support.constant", "constant.other.color"],
      "settings": {
        "foreground": "#ADDB67"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ADDB67"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#82AAFF"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#8CD1F5"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#637777",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#ADDB67"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#FC3E36"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FC3E36"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#D85050"
      }
    }
  ]
}
